# ==============================================================
#  BACKEND — .env.example
#  FityatulHaq Public Website (Web 1) — Express.js BFF/API
#
#  USAGE:
#    1. Copy this file: cp .env.example .env
#    2. Fill in all values — NEVER commit .env
#
#  SECURITY RULES:
#    - This file contains ALL sensitive credentials.
#    - NOTHING from this file should be forwarded to the frontend.
#    - DATABASE_URL must use SSL in production (sslmode=require).
#    - Rotate JWT_SECRET and BACKEND_API_SECRET on every environment
#      promotion (dev → staging → production).
# ==============================================================


# --------------------------------------------------------------
#  1. SERVER
# --------------------------------------------------------------

NODE_ENV=development

# Port the Express server listens on
PORT=4000

# Allowed origins for CORS (comma-separated in production)
# Example: https://fityatulhaq.org,https://www.fityatulhaq.org
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend base URL (used for CORS and redirect validation)
FRONTEND_URL=http://localhost:3000


# --------------------------------------------------------------
#  2. DATABASE — PostgreSQL
#     Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
#     In production: append &sslmode=require
# --------------------------------------------------------------

DATABASE_URL=postgresql:

# Direct connection URL (used by Prisma for migrations — bypasses pgBouncer/pooler)
# In Neon/Supabase setups, this is the non-pooled connection string
DIRECT_URL=

# --------------------------------------------------------------
#  3. JWT AUTHENTICATION
# --------------------------------------------------------------

# Secret for signing JWT access tokens
# Generate with: openssl rand -base64 64
JWT_SECRET=

# Access token expiry (short-lived for security)
JWT_ACCESS_TOKEN_EXPIRY=15m

# Refresh token expiry
JWT_REFRESH_TOKEN_EXPIRY=7d

# Bcrypt salt rounds (cost factor — 12 is recommended for security/performance balance)
BCRYPT_SALT_ROUNDS=12


# --------------------------------------------------------------
#  4. SERVER-TO-SERVER SHARED SECRET
#     Must match BACKEND_API_SECRET in frontend/.env.local
#     Used to authenticate Next.js SSR calls to this Express API
# --------------------------------------------------------------

BACKEND_API_SECRET=

# --------------------------------------------------------------
#  5. SUPABASE — SERVICE ROLE (PRIVILEGED — NEVER EXPOSE PUBLICLY)
#     The anon key is in frontend/.env.example.
#     This Service Role key bypasses Row Level Security — guard it.
# --------------------------------------------------------------

# TODO(user): fill from Supabase dashboard -> Settings -> API
SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------
#  6. RATE LIMITING
#     These values map directly to express-rate-limit config
#     Aligns with NFR: max 5 login attempts / 15 min / IP
# --------------------------------------------------------------

# Global API rate limit (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth-specific rate limit (stricter — aligned with SRS NFR)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=200


# --------------------------------------------------------------
#  7. LOGGING
# --------------------------------------------------------------

LOG_LEVEL=debug
LOG_DIR=./logs


# --------------------------------------------------------------
#  8. FUTURE INTEGRATION — Web 2 Internal Admin Portal
#     Uncomment and fill when the Web 2 sync integration is active.
#     These are used by the syncStatus/sourceId sync mechanism.
# --------------------------------------------------------------

# WEB2_API_BASE_URL=https://internal.admin.fityatulhaq.org/api
# WEB2_API_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_HMAC_SECRET
# WEB2_SYNC_CRON_SCHEDULE="0 */6 * * *"

# --------------------------------------------------------------
# 9. EMAIL DELIVERY - Supabase SMTP
# --------------------------------------------------------------
# Configure these in your Supabase project: Settings -> Email -> SMTP
# (or enable the Email Delivery addon from the Marketplace for managed SMTP).
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SUPABASE_SMTP_USER
SMTP_PASS=REPLACE_WITH_SUPABASE_SMTP_PASSWORD
SMTP_SENDER_EMAIL=noreply@fityatulhaq.org

# --- Superseded: the Resend integration was replaced by Supabase SMTP.
# Kept only so the credential is not lost - nothing reads these any more.
# RESEND_API_KEY=
# RESEND_SENDER_EMAIL=mrasheed.smd1424@gmail.com
#
# # Web 2 Internal API — see backend/src/services/internalApiClient.ts
WEB2_INTERNAL_API_URL=https://api-web2-internal.fityatulhaq.org
# BACKEND_API_SECRET is already declared required by src/index.ts; this is its first consumer.
# Optional overrides:
# WEB2_INTERNAL_TIMEOUT_MS=5000
# SIGNED_URL_TTL_SECONDS=300
# SUPABASE_SIGNED_ASSETS_BUCKET=signed-assets
# ASSET_SIGN_RATE_LIMIT_WINDOW_MS=900000
# ASSET_SIGN_RATE_LIMIT_MAX_ATTEMPTS=100
