# ==============================================================
#  BACKEND — .env.example
#  FityatulHaq Public Website (Web 1) — Express.js BFF/API
#
#  USAGE:
#    1. Copy this file: cp .env.example .env
#    2. Fill in all values — NEVER commit .env
#
#  SECURITY RULES:
#    - This file contains ALL sensitive credentials.
#    - NOTHING from this file should be forwarded to the frontend.
#    - DATABASE_URL must use SSL in production (sslmode=require).
#    - Rotate JWT_SECRET and BACKEND_API_SECRET on every environment
#      promotion (dev → staging → production).
# ==============================================================


# --------------------------------------------------------------
#  1. SERVER
# --------------------------------------------------------------

NODE_ENV=development

# Port the Express server listens on
PORT=4000

# Allowed origins for CORS (comma-separated in production)
# Example: https://fityatulhaq.org,https://www.fityatulhaq.org
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend base URL (used for CORS and redirect validation)
FRONTEND_URL=http://localhost:3000


# --------------------------------------------------------------
#  2. DATABASE — PostgreSQL
#     Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
#     In production: append &sslmode=require
# --------------------------------------------------------------

DATABASE_URL=postgresql://postgres:your_s…word@localhost:5432/fityatulhaq_web1_db?schema=public

# Direct connection URL (used by Prisma for migrations — bypasses pgBouncer/pooler)
DIRECT_URL=postgresql://postgres:your_s…word@localhost:5432/fityatulhaq_web1_db?schema=public


# --------------------------------------------------------------
#  3. JWT AUTHENTICATION
# --------------------------------------------------------------

# Secret for signing JWT access tokens
JWT_SECRET=REPLAC…HARS
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Bcrypt salt rounds (cost factor — 12 is recommended for security/performance balance)
BCRYPT_SALT_ROUNDS=12


# --------------------------------------------------------------
#  4. SERVER-TO-SERVER SHARED SECRET
#     Must match BACKEND_API_SECRET in frontend/.env.local
# --------------------------------------------------------------

BACKEND_API_SECRET=REPLAC…CRET


# --------------------------------------------------------------
#  5. SUPABASE — SERVICE ROLE (PRIVILEGED — NEVER EXPOSE PUBLICLY)
#     The anon key is in frontend/.env.example.
#     This Service Role key bypasses Row Level Security — guard it.
# --------------------------------------------------------------

SUPABASE_URL=https://kbyruvtdprxtdhtcteju.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_s…here
SUPABASE_STORAGE_BUCKET=fityatulhaq-assets


# --------------------------------------------------------------
#  6. RATE LIMITING
#     These values map directly to express-rate-limit config
# --------------------------------------------------------------

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5


# --------------------------------------------------------------
#  7. LOGGING
# --------------------------------------------------------------

LOG_LEVEL=debug
LOG_DIR=./logs


# --------------------------------------------------------------
#  8. FUTURE INTEGRATION — Web 2 Internal Admin Portal
#     Uncomment and fill when the Web 2 sync integration is active.
# --------------------------------------------------------------

# WEB2_API_BASE_URL=https://internal.admin.fityatulhaq.org/api
# WEB2_API_WEBHOOK_SECRET=REPLAC…CRET
# WEB2_SYNC_CRON_SCHEDULE="0 */6 * * *"


# --------------------------------------------------------------
#  9. EMAIL DELIVERY — Supabase SMTP
# --------------------------------------------------------------
# Configure these in your Supabase project: Settings → Email → SMTP
# Or enable Email Delivery addon from Marketplace for managed SMTP.
SMTP_HOST=localhost        # Supabase project SMTP host (e.g., auth.turknett.com)
SMTP_PORT=587              # 587 for STARTTLS, 465 for implicit TLS
SMTP_USER=                 # Supabase project email user
SMTP_PASS=                 # Supabase project SMTP password
SMTP_SENDER_EMAIL=noreply@fityatulhaq.org


# --------------------------------------------------------------
# 10. SESSION COOKIES (httpOnly)
#     The access + refresh tokens are delivered as httpOnly cookies, so no
#     script on the page can read them. `lax` is the right value while the API
#     and the web app share a registrable domain (localhost counts); `strict`
#     is tighter but drops the cookie on inbound links. `none` is only for a
#     genuinely cross-site deployment, and browsers honour it only over HTTPS.
#     Left unset, COOKIE_DOMAIN makes the cookie host-only, which is tighter.
#     Set it when the API lives on a subdomain of the site (api.example.org).
# --------------------------------------------------------------

COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.fityatulhaq.org
