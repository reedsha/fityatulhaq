# ==============================================================
#  FRONTEND — .env.example
#  FityatulHaq Public Website (Web 1) — Next.js
#
#  USAGE:
#    1. Copy this file: cp .env.example .env.local
#    2. Fill in all values — NEVER commit .env.local
#
#  VARIABLE NAMING CONVENTION:
#    - NEXT_PUBLIC_*  : Exposed to the browser bundle (public)
#    - (no prefix)    : Server-side only (never in browser bundle)
#
#  STRICT SEPARATION RULE:
#    - Database credentials, JWT secrets, and Supabase Service Role key
#      MUST NOT be prefixed with NEXT_PUBLIC_ and must live in the
#      backend .env, NOT here.
# ==============================================================


# --------------------------------------------------------------
#  1. APPLICATION (Server-Side — Next.js runtime only)
# --------------------------------------------------------------

# The canonical public URL of this site (no trailing slash)
# Used by NextAuth for callback URLs, sitemap generation, and OG tags
NEXTAUTH_URL=http://localhost:3000

# A strong random secret for NextAuth session encryption
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# The JWT expiry for NextAuth sessions (e.g. 1d, 7d, 30d)
NEXTAUTH_SESSION_MAX_AGE=86400


# --------------------------------------------------------------
#  2. BACKEND API (Server-Side — used in Next.js Server Components
#     and API route handlers to call the Express BFF)
# --------------------------------------------------------------

# Internal Express API base URL (never exposed to browser)
# In production, use your private VPC/internal DNS, not a public URL
BACKEND_API_URL=http://localhost:4000/api/v1

# Shared secret for server-to-server authentication between
# Next.js (SSR layer) and Express (BFF layer)
# Generate with: openssl rand -hex 32
BACKEND_API_SECRET=REPLACE_WITH_STRONG_SHARED_SECRET


# --------------------------------------------------------------
#  3. SUPABASE — PUBLIC (Browser-safe)
#     Only the anonymous/public key is exposed here.
#     The Service Role key is ONLY in backend/.env
# --------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here


# --------------------------------------------------------------
#  4. SITE METADATA (Browser-safe — used for SEO & OG tags)
# --------------------------------------------------------------

NEXT_PUBLIC_SITE_NAME=FityatulHaq
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DESCRIPTION=Portal Komunitas dan Informasi Publik FityatulHaq


# --------------------------------------------------------------
#  5. FEATURE FLAGS (Browser-safe)
# --------------------------------------------------------------

NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false
