# ============================================================
#  FityatulHaq Web 1 — Root .gitignore
# ============================================================

# --- Environment variables (NEVER commit these) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Node ---
node_modules/
frontend/node_modules/
backend/node_modules/

# --- Build outputs ---
frontend/.next/
frontend/out/
backend/dist/

# --- Next.js generated types (recreated on every dev/build run) ---
frontend/next-env.d.ts

# --- Prisma ---
backend/prisma/migrations/*.sql.bak

# --- Logs ---
*.log
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS artifacts ---
.DS_Store
Thumbs.db

# --- IDE ---
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Testing ---
coverage/

# --- Misc ---
*.tsbuildinfo

# --- Prisma CLI scaffolding noise (agent skill docs, skill lock) ---
backend/.claude/
backend/.windsurf/
backend/.agents/
backend/skills-lock.json

# --- Agent scratch, OneDrive staging & other non-source dirs (never commit) ---
# OneDrive's in-flight upload staging; it re-creates files here mid-sync and a
# stray copy would otherwise be swept up by `git add -A`.
.tmp.driveupload/
# Agent runtime state (the coordinator's `memory/` notes) — not project source.
.openclaw/
memory/
.aider*
# OpenClaw dream diary — agent-generated, not project source.
DREAMS.md
