# ============================================================
#  FityatulHaq Web 1 — Root .gitignore
# ============================================================

# --- Environment variables (NEVER commit these) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Node ---
node_modules/
frontend/node_modules/
backend/node_modules/

# --- Build outputs ---
frontend/.next/
frontend/out/
backend/dist/

# --- Prisma ---
backend/prisma/migrations/*.sql.bak

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS artifacts ---
.DS_Store
Thumbs.db

# --- IDE ---
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Testing ---
coverage/

# --- Misc ---
*.tsbuildinfo
